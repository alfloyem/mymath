{
  "name": "mymath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "nuxt dev --host localhost",
    "build": "prisma generate && nuxt build",
    "start": "node scripts/start.mjs",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p .nuxt/tsconfig.app.json && node node_modules/typescript/bin/tsc --noEmit -p .nuxt/tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:integration": "tsx scripts/test-integration.ts",
    "local:db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 start",
    "local:db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 stop",
    "local:db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 status",
    "test:engine": "tsx scripts/test-exam-engine.ts",
    "test:engine:fixtures": "tsx scripts/test-engine-fixtures.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.142",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/i18n": "10.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "h3": "1.15.11",
    "mathjax": "3.2.2",
    "nuxt": "4.6.1",
    "ofetch": "1.5.1",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "vue": "3.5.43",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "dotenv": "18.0.7",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.2",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@11.21.0"
}
